{
  "name": "investment-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=db/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate --schema=db/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema=db/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=db/schema.prisma",
    "prisma:push": "prisma db push --schema=db/schema.prisma",
    "prisma:studio": "prisma studio --schema=db/schema.prisma",
    "seed": "node db/seed.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-select": "^5.10.2",
    "resend": "^6.20.0",
    "uuid": "^14.0.1",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4"
  }
}
